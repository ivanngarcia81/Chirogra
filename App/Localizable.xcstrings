        }
      }
    },
    "Se registra como un gasto pagado con %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorded as an expense paid with %@."
          }
        }
      }
    },
    "Se registra la salida de dinero del banco y se cancela ese saldo a favor en cuentas por cobrar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Records the money leaving the bank and clears that credit in accounts receivable."
          }
        }
      }
    },
    "Se registra un asiento que reduce ingresos, sales tax por pagar y la cuenta por cobrar del cliente. " : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posts an entry that reduces income, sales tax payable, and the customer's receivable. "
          }
        }
      }
    },
    "Se registra un pago por factura, por su saldo completo. El dinero se mueve desde tu banco." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One payment per bill is recorded, for its full balance. The money moves from your bank."
