    },
    "Se reclasificó 1 gasto." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 expense was reclassified."
          }
        }
      }
    },
    "Se registra como transferencia con %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorded as a transfer with %@."
          }
        }
      }
    },
    "Se registra como un depósito en %@ (ingreso sin factura, aportación o devolución)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorded as a deposit to %@ (income without an invoice, contribution or refund)."
