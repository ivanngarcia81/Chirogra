      }
    },
    "Tus marcas se guardan al momento: puedes salir y seguir después." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your checks are saved as you go: you can leave and continue later."
