      }
    },
    "Tus otros aparatos lo borran en cuanto abran Chirogra con conexión. Ya puedes crear tu empresa." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your other devices delete it as soon as they open Chirogra with a connection. You can now set up your company."
          }
        }
      }
    },
    "Tus proveedores son quienes te venden a ti: la tienda de materiales, el casero, tu contador." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your vendors are the ones who sell to you: the supply store, your landlord, your accountant."
