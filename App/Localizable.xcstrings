      }
    },
    "Devolver a la bandeja quita el emparejamiento o la exclusión. Lo que se registró desde el movimiento se queda: anúlalo aparte si sobra." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Returning to the inbox removes the match or the exclusion. Anything recorded from the transaction stays: void it separately if it’s not needed."
          }
        }
      }
    },
