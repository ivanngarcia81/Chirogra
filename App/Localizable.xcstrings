    "Aquí guardas a las personas y empresas a las que les vendes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is where you keep the people and companies you sell to."
          }
        }
      }
    },
    "Aquí van las facturas que te mandan tus proveedores y que pagarás más adelante." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
