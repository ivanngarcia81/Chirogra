          }
        }
      }
    },
    "Compras de equipo y pagos por adelantado" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equipment & prepaid purchases"
          }
        }
      }
    },
    "Compras de equipo, inventario y pagos por adelantado" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equipment, inventory & prepaid purchases"
          }
        }
      }
