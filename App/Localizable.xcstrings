            "value" : "How it goes in your books"
          }
        }
      }
    },
    "Así sabes cuánto ganas de verdad y tienes los recibos a mano para los impuestos." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That way you know what you really earn, and your receipts are handy at tax time."
